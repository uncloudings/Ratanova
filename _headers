# Cache rules for static hosts that read _headers (Cloudflare, Netlify)

# Hashed JS/CSS bundles never change under the same name
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Videos and images keep their names between deploys: cache a week,
# then refresh quietly in the background
/*.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/gallery/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
